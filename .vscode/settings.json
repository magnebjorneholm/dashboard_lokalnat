{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "terminal.integrated.profiles.osx": {
        "zsh (venv)": {
            "path": "zsh",
            "args": ["-l", "-c", "source ./.venv/bin/activate && exec zsh -i"]
        }
    },
    "terminal.integrated.defaultProfile.osx": "zsh (venv)",
    "r.lsp.promptToInstall": false,
    "latex-workshop.latex.outDir": "%DIR%/build",
    "latex-workshop.latex.recipe.default": "latexmk",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "latex-workshop.latex.clean.method": "glob",
    "//latex-comment": "Manuals live at user_manual_latex/manuals/<slug>/main.tex. -r loads the shared latexmkrc ($do_cd, $pdf_mode); the absolute BIBINPUTS lets bibtex find the shared bibliography. %DIR% is the open manual's folder.",
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-r", "%DIR%/../../latexmkrc",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": { "BIBINPUTS": "%DIR%/../../shared:" }
        }
    ],
    "latex-workshop.latex.recipes": [
        { "name": "latexmk", "tools": ["latexmk"] }
    ]
}